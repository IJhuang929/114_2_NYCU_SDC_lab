<launch>
    <arg name="track" default="Track2" />
    <arg name="use_rviz" default="true" />

    <node pkg="rviz" type="rviz" name="display_result" output="screen"
          args="-d $(find localization)/config/localization.rviz"
          if="$(arg use_rviz)" />

    <node pkg="localization" type="localization" name="radar_pcd_publisher" output="screen">
        <rosparam file="$(find localization)/config/params.yaml" command="load" subst_value="true"/>
    </node>
</launch>
